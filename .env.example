PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/wsrms_inventory_db
NODE_ENV=development
SEED_DEMO=true
ADMIN_PASSWORD=Warehouse@2026
STAFF_PASSWORD=Staff@2026
APP_ORIGIN=http://localhost:5173

# Recovery: use a persistent backup host and durable storage (not Vercel local disk)
# Optional: a separately provisioned, fenced HA cluster's single writer endpoint
# HA_DATABASE_URL=postgresql://USER:PASSWORD@HA_ENDPOINT:6432/wsrms_inventory_db?sslmode=verify-full
# HA_NODE_A_URL=https://NODE_A_MONITOR
# HA_NODE_B_URL=https://NODE_B_MONITOR
# HA_NODE_A_NAME=wsrms_inventory_db
# HA_NODE_B_NAME=wsrms_inventory_backup
# HA_MONITOR_USER=monitor
# HA_MONITOR_PASSWORD=PRIVATE_MONITOR_PASSWORD
# BACKUP_DIRECTORY=D:/WSRMS-Recovery
BACKUP_INTERVAL_HOURS=0
BACKUP_WARNING_HOURS=6
# Separate backup PostgreSQL server (Docker Compose exposes port 5434)
# BACKUP_POSTGRES_PASSWORD=YOUR_SEPARATE_BACKUP_PASSWORD
# BACKUP_DATABASE_URL=postgresql://wsrms_backup:YOUR_SEPARATE_BACKUP_PASSWORD@localhost:5434/wsrms_inventory_backup
# EMERGENCY_DATABASE_URL is accepted as a legacy alias for BACKUP_DATABASE_URL
# PG_DUMP_PATH=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
# PG_RESTORE_PATH=C:/Program Files/PostgreSQL/18/bin/pg_restore.exe
# PSQL_PATH=C:/Program Files/PostgreSQL/18/bin/psql.exe
PRESENCE_IDLE_MINUTES=5
PRESENCE_OFFLINE_MINUTES=30

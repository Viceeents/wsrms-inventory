{
  "name": "wsrms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/src/server.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/src/server.js",
    "test": "node scripts/run-tests.js",
    "test:ui": "node scripts/run-tests.js ui",
    "db:setup": "node scripts/setup-database.js",
    "db:backup": "node scripts/backup-database.js",
    "db:backup-worker": "node scripts/backup-worker.js",
    "format": "prettier --write .",
    "test:production": "npm run build && node scripts/run-tests.js production"
  },
  "dependencies": {
    "chart.js": "^4.5.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  }
}

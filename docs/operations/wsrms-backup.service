[Unit]
Description=WSRMS backup server and administrative recovery interface
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=wsrms
Group=wsrms
WorkingDirectory=/opt/wsrms
EnvironmentFile=/etc/wsrms/backup.env
ExecStart=/usr/bin/node /opt/wsrms/server/src/server.js
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

          }
        },
        {
          "name": "Transfer parcel (Stored parcel only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/parcels/{{parcelId}}/transfer",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location_id\": \"{{locationId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {

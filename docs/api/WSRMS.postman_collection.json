{
  "info": {
    "name": "WSRMS · Warehouse operations",
    "description": "Local API workflows. Sign in first. Cookies are stored automatically. Requests mutate warehouse records; use a development database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3001/api"
    },
    {
      "key": "parcelId",
      "value": "1"
    },
    {
      "key": "parcelCode",
      "value": ""
    },
    {
      "key": "locationId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Sign in as administrator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@wsrms.local\",\n  \"password\": \"Warehouse@2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Current account",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Sign in as staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@wsrms.local\",\n  \"password\": \"Staff@2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Sign out",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Parcel workflow · run in order",
      "item": [
        {
          "name": "1. Recommend storage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/parcels/recommendations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tracking_number\": \"POSTMAN-{{$timestamp}}\",\n  \"description\": \"Postman sample parcel\",\n  \"category_id\": 1,\n  \"size\": \"Small\",\n  \"weight\": 1,\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const locations = pm.response.json();",
                  "if (locations.length) pm.collectionVariables.set(\"locationId\", locations[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Confirm check-in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/parcels",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tracking_number\": \"POSTMAN-{{$timestamp}}\",\n  \"description\": \"Postman sample parcel\",\n  \"category_id\": 1,\n  \"size\": \"Small\",\n  \"weight\": 1,\n  \"quantity\": 1,\n  \"location_id\": \"{{locationId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const p = pm.response.json();",
                  "if (p.id) { pm.collectionVariables.set(\"parcelId\", p.id); pm.collectionVariables.set(\"parcelCode\", p.code); }"
                ]
              }
            }
          ]
        },
        {
          "name": "3. View parcel",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/parcels/{{parcelId}}"
          }
        },
        {
          "name": "4. Shortest route",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/parcels/{{parcelId}}/route"
          }
        },
        {
          "name": "5. Mark retrieved",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/parcels/{{parcelId}}/retrieve"
          }
        },
        {
          "name": "6. Wrong code · expected 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/parcels/{{parcelId}}/dispatch",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scanned_code\": \"WRONG-CODE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Wrong parcel rejected\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Verify scanned label",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/parcels/{{parcelId}}/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scanned_code\": \"{{parcelCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "8. Confirm verified dispatch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/parcels/{{parcelId}}/dispatch",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scanned_code\": \"{{parcelCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "9. Parcel history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/transactions?parcel={{parcelId}}"
          }
        }
      ]
    },
    {
